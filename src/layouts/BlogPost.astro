---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 760px;
        max-width: calc(100% - 2em);
        margin: 0 auto 2.5rem;
      }
      .hero-image img {
        display: block;
        width: 100%;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .title {
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border-soft);
      }
      .date {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.02em;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .last-updated-on {
        font-style: italic;
      }
    </style>
    <style is:global>
      /* Post body: a ~70 character column, normal type sizes, and quiet code,
         table and quote styles on the dark gray background. Also used by /about. */
      body {
        background-image: none !important;
      }
      .prose {
        width: 760px;
        max-width: calc(100% - 2em);
        margin: auto;
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--text);
      }
      .prose .title h1 {
        font-size: clamp(1.9rem, 1.3rem + 2.2vw, 2.6rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .prose h2 {
        font-size: 1.5rem;
        letter-spacing: -0.01em;
        margin: 2.6em 0 0.8em;
        padding-bottom: 0.35em;
        border-bottom: 1px solid var(--border-soft);
      }
      .prose h3 {
        font-size: 1.2rem;
        margin: 2em 0 0.6em;
      }
      .prose h4 {
        font-size: 1.05rem;
        margin: 1.6em 0 0.5em;
      }
      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 {
        color: var(--text-strong);
        line-height: 1.3;
      }
      .prose p {
        margin: 0 0 1.25em;
      }
      .prose strong {
        color: var(--text-strong);
      }
      .prose a {
        color: var(--accent-soft);
        text-decoration: underline;
        text-decoration-color: rgba(74, 222, 128, 0.35);
        text-underline-offset: 3px;
        transition: text-decoration-color 0.15s ease;
      }
      .prose a:hover {
        text-decoration-color: currentColor;
      }

      .prose ul,
      .prose ol {
        margin: 0 0 1.25em;
        padding-left: 1.4em;
      }
      .prose ul {
        list-style: disc;
      }
      .prose ol {
        list-style: decimal;
      }
      .prose li {
        margin: 0.35em 0;
        padding-left: 0.2em;
      }
      .prose li::marker {
        color: var(--accent);
      }
      .prose li > ul,
      .prose li > ol {
        margin: 0.35em 0 0;
      }

      /* Code blocks: Shiki colors the tokens (astro.config.mjs), the block
         itself sits on the card surface. */
      .prose pre {
        margin: 1.5em 0 1.75em;
        padding: 0.95rem 1.15rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background-color: var(--surface) !important;
        font-size: 0.85rem;
        line-height: 1.65;
        overflow-x: auto;
      }

      /* Tables scroll on their own when wider than the column. */
      .prose table {
        display: block;
        width: max-content;
        max-width: 100%;
        overflow-x: auto;
        margin: 1.5em 0 1.75em;
        border-collapse: collapse;
        font-size: 0.9rem;
        line-height: 1.5;
      }
      .prose th,
      .prose td {
        padding: 0.55em 0.9em;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }
      .prose th {
        background-color: var(--surface-2);
        color: var(--text-strong);
        font-weight: 700;
      }
      .prose tbody tr:nth-child(even) td {
        background-color: rgba(255, 255, 255, 0.018);
      }

      .prose blockquote {
        margin: 1.5em 0;
        padding: 0.8em 1.1em;
        border-left: 3px solid var(--accent);
        border-radius: 0 8px 8px 0;
        background-color: rgba(34, 197, 94, 0.06);
        color: var(--text);
      }
      .prose blockquote p:last-child {
        margin-bottom: 0;
      }
      .prose hr {
        margin: 2.5em 0;
      }
      .prose img {
        margin: 1.5em auto;
      }

      @media (max-width: 720px) {
        .prose {
          font-size: 1rem;
        }
        .prose h2 {
          font-size: 1.3rem;
        }
        .prose h3 {
          font-size: 1.1rem;
        }
        .prose pre {
          font-size: 0.8rem;
          padding: 0.8rem 0.9rem;
        }
      }
    </style>
  </head>

  <body class="bg-dommy-black">
    <Header />
    <main class="container min-h-screen mx-auto lg:px-8 py-12 sm:px-0">
      <article>
        {
          heroImage && (
            <div class="hero-image">
              <img width={1020} height={510} src={heroImage} alt="" />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
