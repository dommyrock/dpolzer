---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
// The path as a terminal location in the title band, e.g. ~/blog/<slug>
const location = "~" + Astro.url.pathname.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      /* Post body (also /about): a ~70 character column, Chakra Petch headings,
         readable sans text, and code, table and quote panels on the graphite
         ground. */
      .prose {
        width: 760px;
        max-width: calc(100% - 2.5rem);
        margin: auto;
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--text);
      }
      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4,
      .prose h5,
      .prose h6 {
        font-family: var(--font-display);
        color: var(--text-strong);
        line-height: 1.3;
        letter-spacing: 0.01em;
      }
      .prose h2 {
        font-size: 1.55rem;
        font-weight: 600;
        margin: 2.6em 0 0.8em;
      }
      .prose h2::before {
        content: "// ";
        font-family: var(--font-mono);
        font-size: 0.8em;
        color: var(--accent);
      }
      .prose h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 2em 0 0.6em;
      }
      .prose h4 {
        font-size: 1.05rem;
        margin: 1.6em 0 0.5em;
      }
      .prose p {
        margin: 0 0 1.25em;
      }
      .prose strong {
        color: var(--text-strong);
      }
      .prose a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: rgba(74, 222, 128, 0.35);
        text-underline-offset: 3px;
      }
      .prose a:hover {
        color: var(--accent-soft);
        text-decoration-color: currentColor;
      }

      .prose ul,
      .prose ol {
        margin: 0 0 1.25em;
        padding-left: 1.4em;
      }
      .prose ul {
        list-style: square;
      }
      .prose ol {
        list-style: decimal;
      }
      .prose li {
        margin: 0.35em 0;
        padding-left: 0.2em;
      }
      .prose li::marker {
        color: var(--accent);
      }
      .prose li > ul,
      .prose li > ol {
        margin: 0.35em 0 0;
      }

      /* Code blocks: Shiki colors the tokens (astro.config.mjs), the block sits
         on the panel surface. */
      .prose pre {
        margin: 1.5em 0 1.75em;
        padding: 0.95rem 1.15rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background-color: var(--surface) !important;
        font-size: 0.85rem;
        line-height: 1.65;
        overflow-x: auto;
      }

      /* Tables scroll on their own when wider than the column. */
      .prose table {
        display: block;
        width: max-content;
        max-width: 100%;
        overflow-x: auto;
        margin: 1.5em 0 1.75em;
        border-collapse: collapse;
        font-size: 0.9rem;
        line-height: 1.5;
      }
      .prose th,
      .prose td {
        padding: 0.55em 0.9em;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }
      .prose th {
        background-color: var(--surface);
        color: var(--text-strong);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.04em;
      }
      .prose tbody tr:nth-child(even) td {
        background-color: rgba(255, 255, 255, 0.015);
      }

      .prose blockquote {
        margin: 1.5em 0;
        padding: 0.8em 1.1em;
        border-left: 2px solid var(--accent);
        background-color: rgba(74, 222, 128, 0.06);
        color: var(--text);
      }
      .prose blockquote p:last-child {
        margin-bottom: 0;
      }
      .prose hr {
        margin: 2.5em 0;
      }
      .prose img {
        margin: 1.5em auto;
      }

      @media (max-width: 720px) {
        .prose {
          font-size: 1rem;
        }
        .prose h2 {
          font-size: 1.3rem;
        }
        .prose h3 {
          font-size: 1.1rem;
        }
        .prose pre {
          font-size: 0.8rem;
          padding: 0.8rem 0.9rem;
        }
      }
    </style>
  </head>

  <body class="bg-dommy-black">
    <Header />
    <section class="grid-band border-b border-[var(--border-soft)]">
      <div class="mx-auto w-[760px] max-w-[calc(100%-2.5rem)] pb-10 pt-14 sm:pb-12 sm:pt-20">
        <div class="mb-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs uppercase tracking-[0.12em] text-[var(--text-muted)]">
          <span class="normal-case tracking-normal text-[var(--teal)]">{location}</span>
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span>
                updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </div>
        <h1
          class="m-0 font-display text-[clamp(1.9rem,1.3rem+2.2vw,2.75rem)] font-semibold leading-[1.15] tracking-[0.005em] text-[var(--text-strong)]"
        >
          {title}
        </h1>
      </div>
    </section>
    <main class="m-0 w-full max-w-none px-0 pb-12 pt-10 sm:pt-12">
      <article>
        {
          heroImage && (
            <div class="mx-auto mb-10 w-[760px] max-w-[calc(100%-2.5rem)]">
              <img
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                class="block w-full rounded border border-[var(--border)]"
              />
            </div>
          )
        }
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
