---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HelixBand from "../../components/HelixBand.astro";

// Every post, newest first, as the home page's log rows plus each description.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Posts | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-dommy-black">
    <Header />
    <section class="relative overflow-hidden border-b border-[var(--border-soft)]">
      <HelixBand seed="/blog" />
      <div class="relative mx-auto w-[880px] max-w-[calc(100%-2.5rem)] pb-10 pt-14 sm:pb-12 sm:pt-20">
        <div class="mb-4 flex gap-4 font-mono text-xs uppercase tracking-[0.12em] text-[var(--text-muted)]">
          <span class="normal-case tracking-normal text-[var(--teal)]">~/blog</span>
          <span>{posts.length} posts</span>
        </div>
        <h1 class="m-0 font-display text-[clamp(1.9rem,1.3rem+2.2vw,2.75rem)] font-semibold leading-[1.15] text-[var(--text-strong)]">
          Posts
        </h1>
      </div>
    </section>
    <main class="m-0 w-full max-w-none px-0 pb-12 pt-10 sm:pt-12">
      <div class="log mx-auto w-[880px] max-w-[calc(100%-2.5rem)]">
        {
          posts.map((post) => (
            <a class="log-row" href={`/blog/${post.id}/`}>
              <span class="log-date">
                <FormattedDate date={post.data.pubDate} />
              </span>
              <span class="log-title">
                {post.data.title}
                <span class="mt-1 block font-[Atkinson,sans-serif] text-sm leading-normal text-[var(--text-muted)]">
                  {post.data.description}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
