---
// Infographic: what the component weighs. Bars grow when scrolled into view.
interface Props { rows: { label: string; kb: number; note: string }[] }
const { rows } = Astro.props;
const max = Math.max(...rows.map((r) => r.kb), 1);
---

<figure class="ep-budget" aria-label="Download size of the component">
  {
    rows.map((r) => (
      <div class="ep-b-row">
        <span class="ep-b-label">{r.label}</span>
        <span class="ep-b-track"><i style={`--w:${Math.max(0.6, (r.kb / max) * 100)}%`} /></span>
        <span class="ep-b-val">{r.kb} KB</span>
        <small>{r.note}</small>
      </div>
    ))
  }
</figure>

<script>
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))),
    { threshold: 0.4 },
  );
  document.querySelectorAll(".ep-budget").forEach((el) => io.observe(el));
</script>

<style>
  .ep-budget { margin: 1.6em 0 2em; padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); display: grid; gap: 0.75rem; }
  .ep-b-row { display: grid; grid-template-columns: 9.5rem 1fr 5rem; column-gap: 0.8rem; align-items: center; font-family: var(--font-mono); font-size: 0.8rem; }
  .ep-b-label { color: var(--text-strong); }
  .ep-b-track { height: 10px; background: var(--border-soft); border-radius: 2px; overflow: hidden; }
  .ep-b-track i { display: block; height: 100%; width: var(--w); background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .ep-budget.in .ep-b-track i { transform: scaleX(1); }
  .ep-b-val { text-align: right; color: var(--accent); }
  .ep-b-row small { grid-column: 2 / -1; font-family: inherit; font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; margin-top: 2px; }
  @media (max-width: 720px) { .ep-b-row { grid-template-columns: 1fr 4.5rem; } .ep-b-track { grid-column: 1 / -1; order: 3; } .ep-b-row small { grid-column: 1 / -1; order: 4; } }
  @media (prefers-reduced-motion: reduce) { .ep-b-track i { transition: none; transform: none; } }
</style>
