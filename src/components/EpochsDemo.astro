---
// The procedural city (src/epochs) as a web component, broken out of the post column to
// nearly the full page width. The module loads after first paint.
---

<div class="epochs-bleed">
  <game-loop-2d-ortho></game-loop-2d-ortho>
</div>

<script>
  const boot = () => import("../epochs/element");
  if ("requestIdleCallback" in window) requestIdleCallback(boot, { timeout: 800 });
  else setTimeout(boot, 200);
</script>

<style is:global>
  /* 100vw includes a classic scrollbar's width; clip the sliver instead of scrolling sideways */
  html { overflow-x: clip; }
  .epochs-bleed {
    width: calc(100vw - 16px);
    margin: 0 0 2.2rem calc(50% - 50vw + 8px);
    height: min(84vh, 900px);
    min-height: 480px;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: #0b0e14;
  }
  .epochs-bleed game-loop-2d-ortho { display: block; width: 100%; height: 100%; }
</style>
