---
import RecentPosts from "./RecentPosts.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import FeaturedProject from "./FeaturedProject.astro";
import Footer from "./Footer.astro";
import Helix from "./Helix.astro";
---

{/* The helix spans this element's height, behind the content. */}
<div class="relative min-h-screen bg-dommy-black font-mono text-[15px] leading-[1.65] text-[var(--text)]">
  <Helix />
  <div class="relative z-10">
    <Header />
    <Hero />
    <main class="m-0 w-full max-w-none p-0">
      <FeaturedProject />
      <RecentPosts />
    </main>
    <Footer />
  </div>
</div>
