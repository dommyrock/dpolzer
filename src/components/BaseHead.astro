---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Blog posts: emitted as og:type=article plus BlogPosting structured data. */
	article?: { headline: string; published: Date; modified?: Date };
	/** Keep the page out of search results (e.g. the 404 page). */
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/thumb.jpg', article, noindex = false } = Astro.props;
const imageURL = new URL(image, Astro.url).href;

// Google only reads WebSite site-name markup from the domain root, so the
// structured data below is emitted on the home page only. Without it Search
// falls back to the registrable domain (pages.dev) and labels the result
// "Cloudflare" instead of "Dominik Polzer".
const isHome = Astro.url.pathname === '/';
const siteUrl = Astro.site?.href ?? '/';
// The site owner, shared by the WebSite and BlogPosting structured data.
const person = {
	'@type': 'Person',
	name: 'Dominik Polzer',
	url: siteUrl,
	sameAs: [
		'https://github.com/dommyrock',
		'https://linkedin.com/in/dominik-polzer-hi-o/',
		'https://x.com/dompolzer',
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Favicons. Google's favicon crawler looks for /favicon.ico at the site root
     first, so ship the .ico alongside the scalable SVG. -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<!-- Chakra Petch for headings, JetBrains Mono for the terminal-style UI and code -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
/>

<!-- Google Search Console ownership verification -->
<meta name="google-site-verification" content="CZGJ7ON4WT33X4vR1rc1iiOmHPUq_zzlCl3uHcpHzdg" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Dominik Polzer" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
<meta name="twitter:creator" content="@dompolzer" />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}

<!-- Site name for Google Search results -->
{
	isHome && (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				alternateName: ['D.Polzer', 'dpolzer'],
				url: siteUrl,
				publisher: person,
			})}
		/>
	)
}
{
	article && (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: article.headline,
				description,
				image: imageURL,
				url: canonicalURL.href,
				mainEntityOfPage: canonicalURL.href,
				datePublished: article.published.toISOString(),
				...(article.modified && { dateModified: article.modified.toISOString() }),
				author: person,
			})}
		/>
	)
}
