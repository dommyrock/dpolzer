---
import HeaderLink from "./HeaderLink.astro";
import { Terminal } from "@phosphor-icons/react";
const today = new Date();
---

<footer class="border-t border-green-500 mt-16 bg-dommy-black">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex w-full flex-wrap items-center justify-center gap-x-2 text-base text-gray-300">
      <span>{new Date().getFullYear()} DOMINIK POLZER |</span>
      <div class="flex items-center gap-1">
        <Terminal size={32} />
        <HeaderLink href="/blog">ls ./posts</HeaderLink>
      </div>
    </div>
  </div>
</footer>
