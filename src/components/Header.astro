---
import { LinkedinLogo, GithubLogo, Terminal, XLogo } from "@phosphor-icons/react";

const onAbout = Astro.url.pathname.replace(/\/$/, "") === "/about";
const socials = [
  { href: "https://github.com/dommyrock", label: "GitHub", Icon: GithubLogo },
  { href: "https://linkedin.com/in/dominik-polzer-hi-o/", label: "LinkedIn", Icon: LinkedinLogo },
  { href: "https://x.com/dompolzer", label: "X", Icon: XLogo },
];
---

<header class="relative z-20 border-b border-[var(--border-soft)] bg-[rgba(11,13,16,0.9)] font-mono print:hidden">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-5 py-2.5 sm:px-8">
    <a
      href="/"
      class="flex min-h-11 items-center gap-2.5 text-base font-bold text-[var(--accent)] no-underline hover:text-[var(--accent-soft)]"
    >
      <Terminal size={22} />
      <span><span class="text-[var(--text-muted)]">~/</span>dominik.polzer</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1.5">
      <a
        href="/about"
        aria-current={onAbout ? "page" : undefined}
        class:list={[
          "mr-2.5 inline-flex min-h-9 items-center px-3.5 text-[13px] font-bold text-[#04150a] no-underline transition-colors hover:bg-[var(--accent-soft)] hover:text-[#04150a]",
          onAbout ? "bg-[var(--accent-soft)]" : "bg-[var(--accent)]",
        ]}
      >
        cd ./about
      </a>
      {
        socials.map(({ href, label, Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="inline-flex h-11 w-11 items-center justify-center text-[var(--text)] transition-colors hover:text-[var(--accent)]"
          >
            <Icon size={20} />
          </a>
        ))
      }
    </nav>
  </div>
</header>
