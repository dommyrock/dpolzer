---
import HeaderLink from "./HeaderLink.astro";
import { LinkedinLogo, GithubLogo, Terminal, XLogo } from "@phosphor-icons/react";
---

<header
  class="rule-bottom flex flex-col gap-2 print:hidden text-green-500 font-mono bg-dommy-black"
>
  <h2 class="flex w-full flex-wrap items-center justify-center gap-x-4 gap-y-2 text-base sm:text-xl pt-3">
    <Terminal size={32} />
    <HeaderLink href="/">
      <span class="text-crimson-9">~/</span>dominik.polzer
    </HeaderLink>
    <HeaderLink
      href="/about"
      class="bg-green-500 px-3 py-1 text-sm font-semibold text-black no-underline transition-colors hover:bg-green-400 sm:text-base"
    >
      cd ./about
    </HeaderLink>
  </h2>
  <div class="mb-4 flex w-full justify-center gap-4">
    <HeaderLink href="https://github.com/dommyrock" target="_blank">
      <GithubLogo size={24} />
    </HeaderLink>
    <HeaderLink href="https://linkedin.com/in/dominik-polzer-hi-o/" target="_blank">
      <LinkedinLogo size={24} />
    </HeaderLink>
    <HeaderLink href="https://x.com/dompolzer" target="_blank">
      <XLogo size={24} />
    </HeaderLink>
  </div>
</header>
