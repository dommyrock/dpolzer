---
// Hero: a terminal session over the helix background (Helix.astro). `whoami`
// answers with the role; `$ cd posts` scrolls to the posts, and Helix.astro
// draws a dotted underline under it on hover and focus.
---

<section>
  <div
    class="mx-auto flex max-w-[1200px] flex-col items-center gap-4 px-5 pb-16 pt-24 text-center sm:px-8 md:pb-20 md:pt-[132px]"
  >
    <h1
      aria-label="Dominik Polzer"
      class="m-0 font-mono text-[clamp(22px,3.6vw,48px)] font-bold leading-tight tracking-tight"
    >
      <span class="text-[var(--accent)]">dominik</span><span class="text-gray-600">@</span><span
        class="text-[var(--teal)]">polzer</span
      ><span class="text-gray-600">:~$</span> <span class="text-slate-100">whoami</span>
    </h1>
    <p class="mb-0 mt-2.5 flex items-center justify-center gap-3 font-mono text-sm text-[#e6edf3] sm:text-lg">
      <span class="hero-dot inline-block h-2 w-2 shrink-0 rounded-full"></span>
      Distributed Systems Engineer @ Exein
    </p>
    <p class="m-0 max-w-[680px] font-mono text-sm text-[#8f9caa] sm:text-[15px]">
      10+ years building distributed systems — Rust, .NET and applied AI.
    </p>
    <a
      href="#posts"
      data-helix-underline
      class="cd-posts mt-6 inline-flex min-h-[52px] items-center px-2 font-mono text-base text-[#e6edf3] no-underline"
    >
      <span data-helix-underline-text
        ><span class="mr-2.5 text-[#6b7785]">$</span><span class="cd-cmd">cd posts</span><span
          class="hero-cursor ml-0.5 text-[var(--accent)]">▊</span
        ></span
      >
    </a>
  </div>
</section>

<style>
  .hero-dot {
    background-color: var(--teal);
    box-shadow: 0 0 10px rgba(45, 212, 191, 0.8);
    animation: hero-pulse 2.4s ease-in-out infinite;
  }
  .hero-cursor {
    animation: hero-blink 1.1s steps(1, end) infinite;
  }
  .cd-cmd {
    transition:
      color 0.2s ease,
      text-shadow 0.2s ease;
  }
  .cd-posts:hover .cd-cmd,
  .cd-posts:focus-visible .cd-cmd {
    color: var(--accent-soft);
    text-shadow: 0 0 12px rgba(74, 222, 128, 0.65);
  }
  .cd-posts:focus-visible {
    outline: 1px dashed rgba(74, 222, 128, 0.6);
    outline-offset: 6px;
  }
  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.8);
    }
  }
  @keyframes hero-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-dot,
    .hero-cursor {
      animation: none;
    }
  }
</style>
